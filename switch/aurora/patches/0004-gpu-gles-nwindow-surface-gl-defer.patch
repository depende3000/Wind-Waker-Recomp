 static bool create_surface() {
+#if defined(__SWITCH__)
+  {
+    window::SurfaceLock surfaceLock;
+    // The window needs its buffer size set before EGL draws to it, as libnx's
+    // own framebuffer API does.
+    NWindow* window = nwindowGetDefault();
+    nwindowSetDimensions(window, 1280, 720);
+    wgpu::SurfaceSourceAndroidNativeWindow nwindow;
+    nwindow.window = window;
+    const wgpu::SurfaceDescriptor switchSurfaceDescriptor{
+        .nextInChain = &nwindow,
+        .label = "Surface",
+    };
+    release_surface_locked();
+    g_surface = g_instance.CreateSurface(&switchSurfaceDescriptor);
+    if (!g_surface) {
+      Log.error("Failed to create surface");
+      return false;
+    }
+    return true;
+  }
